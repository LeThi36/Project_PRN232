@{
    // Lấy thông tin admin từ cookie. Giả sử bạn lưu email trong cookie "AdminEmail".
    // Nếu không có, sẽ hiển thị tên mặc định là "Admin".
    var studentCode = Context.Request.Cookies["StudentCode"];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <link href="~/css/font-face.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/vendor/fontawesome-6.7.2/css/all.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/vendor/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/vendor/bootstrap-5.3.7/css/bootstrap.bundle.min.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/css/aos.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/vendor/css-hamburgers/hamburgers.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/swiper-bundle.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/vendor/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/css/theme.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />
    <link rel="stylesheet" href="~/css/animate.css" />
    <link rel="stylesheet" href="~/css/magnific-popup.css" />
    <link rel="stylesheet" href="~/css/meanmenu.css" />
    <link rel="stylesheet" href="~/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/nice-select.css" />
    <link rel="stylesheet" href="~/css/icomoon.css" />
    <link rel="stylesheet" href="~/css/main.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.27/dist/sweetalert2.min.css" rel="stylesheet">
</head>
<body>
    <div class="page-wrapper">
        <header class="header-mobile d-block d-lg-none">
            <div class="header-mobile__bar">
                <div class="container-fluid">
                    <div class="header-mobile-inner">
                        <a class="logo" asp-page="/Admin/Index">
                            <img src="~/img/icon/logo.png" alt="CoolAdmin" />
                        </a>
                        <button class="hamburger hamburger--slider" type="button">
                            <span class="hamburger-box">
                                <span class="hamburger-inner"></span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
            <nav class="navbar-mobile">
                <div class="container-fluid">
                    <ul class="navbar-mobile__list list-unstyled">
                        <li>
                            <a asp-page="/Admin/Index"><i class="fas fa-tachometer-alt"></i>Dashboard</a>
                        </li>
                        <li>
                            <a asp-page="/Book/Index"><i class="fas fa-book"></i>Books</a>
                        </li>
                        <li>
                            <a asp-page="/ManageBorrowOrders/Index"><i class="fas fa-table"></i>Manager BorrowOrder</a>
                        </li>
                        <li>
                            <a asp-page="/Publisher/Index"><i class="fas fa-table"></i>Manager Publisher</a>
                        </li>
                        <li>
                            <a asp-page="/Category/Index"><i class="fas fa-table"></i>Manager Category</a>
                        </li>
                        <li>
                            <a asp-page="/Author/Index"><i class="fas fa-table"></i>Manager Author</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <aside class="menu-sidebar d-none d-lg-block">
            <div class="logo">
                <a asp-page="/Admin/Index">
                    <img src="~/img/icon/logo.png" alt="Cool Admin" />
                </a>
            </div>
            <div class="menu-sidebar__content js-scrollbar1">
                <nav class="navbar-sidebar">
                    <ul class="list-unstyled navbar__list">
                        
                        <li>
                            <a asp-page="/Book/Index"><i class="fas fa-book"></i>Books</a>
                        </li>
                        <li>
                            <a asp-page="/ManageBorrowOrders/Index"><i class="fas fa-table"></i>Manager BorrowOrder</a>
                        </li>
                        <li>
                            <a asp-page="/Publisher/Index"><i class="fas fa-table"></i>Manager Publisher</a>
                        </li>
                        <li>
                            <a asp-page="/Category/Index"><i class="fas fa-table"></i>Manager Category</a>
                        </li>
                        <li>
                            <a asp-page="/Author/Index"><i class="fas fa-table"></i>Manager Author</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <div class="page-container">
            <header class="header-desktop">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="header-wrap">
                            <form class="form-header" action="" method="POST">
                                <input class="au-input au-input--xl" type="text" name="search" placeholder="Search..." />
                                <button class="au-btn--submit" type="submit">
                                    <i class="zmdi zmdi-search"></i>
                                </button>
                            </form>
                            <div class="header-button">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(studentCode) && Context.Request.Cookies.ContainsKey("AccessToken"))
                                    {
                                    // --- KHI ĐÃ ĐĂNG NHẬP ---
                                        <span class="text-white me-3">
                                            Welcome, <strong>@studentCode</strong>
                                        </span>
                                        <form method="post" asp-page="/Login/Logout">
                                            <button type="submit" class="au-btn au-btn--small au-btn--red">
                                                <i class="zmdi zmdi-power"></i> Logout
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        // --- KHI CHƯA ĐĂNG NHẬP ---
                                        <a asp-page="/Login/Login" class="au-btn au-btn--small au-btn--green">
                                            <i class="zmdi zmdi-account-circle"></i> Login
                                        </a>
                                    }
                                </div>
                            </div>
                    </div>
                </div>
            </header>

            <div class="main-content">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        @RenderBody()
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="copyright">
                            <p>Copyright © @DateTime.Now.Year Colorlib. All rights reserved.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/vanilla-utils.js" asp-append-version="true"></script>
    <script src="~/vendor/bootstrap-5.3.7/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/vendor/perfect-scrollbar/perfect-scrollbar.min.js" asp-append-version="true"></script>
    <script src="~/vendor/chartjs/Chart.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/bootstrap5-init.js" asp-append-version="true"></script>
    <script src="~/js/main-vanilla.js" asp-append-version="true"></script>
    <script src="~/vendor/swiper/swiper-bundle.min.js" asp-append-version="true"></script>
    <script src="~/vendor/aos/aos.js" asp-append-version="true"></script>
    <script src="~/js/modern-plugins.js" asp-append-version="true"></script>
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/viewport.jquery.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery.nice-select.min.js"></script>
    <script src="~/js/jquery.waypoints.js"></script>
    <script src="~/js/jquery.counterup.min.js"></script>
    <script src="~/js/swiper-bundle.min.js"></script>
    <script src="~/js/jquery.meanmenu.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/gsap.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>