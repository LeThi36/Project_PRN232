@page
@model LibraryWebApp.Pages.Publisher.IndexModel
@{
    ViewData["Title"] = "Manage Publishers";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}
@if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))

{

    var msg = TempData["StatusMessage"].ToString();

    var isError = msg.Contains("Failed") || msg.Contains("Invalid");
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<section class="pt-120 pb-120">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="title mb-0">Publisher Management</h2>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="fa fa-plus"></i> Add Publisher
            </button>
        </div>

        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Search by name or ID" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="/Publisher/Index" class="btn btn-secondary ms-2">Reset</a>
            </div>
        </form>


        <table class="table table-striped table-bordered mt-3">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Publishers != null && Model.Publishers.Any())
                {
                    int count = 1;
                    foreach (var publisher in Model.Publishers)
                    {
                        <tr>
                            <td>@count++</td>
                            <td>@publisher.PublisherName</td>
                            <td>@publisher.Address</td>
                            <td>@publisher.PhoneNumber</td>
                            <td>
                                <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@publisher.Id">
                                    Edit
                                </button>
                                <form asp-page-handler="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="Id" value="@publisher.Id" />
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>

                        <!-- Edit Modal -->
                        <div class="modal fade" id="editModal-@publisher.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Publisher</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-page-handler="Edit" method="post" class="needs-validation" novalidate>
                                        <div class="modal-body">
                                            <input type="hidden" name="Publisher.Id" value="@publisher.Id" />
                                            <div class="mb-3">
                                                <label class="form-label">Name</label>
                                                <input type="text" name="Publisher.PublisherName" value="@publisher.PublisherName" class="form-control" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Address</label>
                                                <input type="text" name="Publisher.Address" value="@publisher.Address" class="form-control" />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Phone</label>
                                                <input type="text" name="Publisher.PhoneNumber" value="@publisher.PhoneNumber" class="form-control" pattern="^\d{10,15}$" />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="submit" class="btn btn-primary">Save</button>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        </div>
                                    </form>


                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No publishers found.</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)

        {

            var startPage = Math.Max(1, Model.Page - 2);

            var endPage = Math.Min(Model.TotalPages, Model.Page + 2);

            <nav>
                <ul class="pagination justify-content-center">
                    @if (Model.Page > 3)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?search=@Model.Search&pageIndex=1">« First</a>
                        </li>
                    }

                    @if (Model.Page > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?search=@Model.Search&pageIndex=@(Model.Page - 1)">‹ Prev</a>
                        </li>
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(Model.Page == i ? "active" : "")">
                            <a class="page-link" href="?search=@Model.Search&pageIndex=@i">@i</a>
                        </li>
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?search=@Model.Search&pageIndex=@(Model.Page + 1)">Next ›</a>
                        </li>
                    }

                    @if (Model.Page < Model.TotalPages - 2)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?search=@Model.Search&pageIndex=@Model.TotalPages">Last »</a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
    <!-- Create Modal -->
    <div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Publisher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-page-handler="Create" asp-for="NewPublisher" method="post" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="NewPublisher.PublisherName" class="form-label"></label>
                            <input asp-for="NewPublisher.PublisherName" class="form-control" />
                            <span asp-validation-for="NewPublisher.PublisherName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPublisher.Address" class="form-label"></label>
                            <input asp-for="NewPublisher.Address" class="form-control" />
                            <span asp-validation-for="NewPublisher.Address" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPublisher.PhoneNumber" class="form-label"></label>
                            <input asp-for="NewPublisher.PhoneNumber" class="form-control" />
                            <span asp-validation-for="NewPublisher.PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

</section>



<script>
    setTimeout(function () {
        var alertBox = document.querySelector('.alert');
        if (alertBox) {
            var alert = new bootstrap.Alert(alertBox);
            alert.close();
        }
    }, 5000);

    // Bootstrap client-side validation
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();

    // Auto open modal again if validation failed
    document.addEventListener("DOMContentLoaded", function () {
        var showCreate = '@TempData["ShowCreateModal"]' === 'true';
        if (showCreate) {
            const createModal = new bootstrap.Modal(document.getElementById("createModal"));
            createModal.show();
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
