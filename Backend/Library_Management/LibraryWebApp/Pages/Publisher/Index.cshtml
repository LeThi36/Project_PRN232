@page
@model LibraryWebApp.Pages.Publisher.IndexModel
@{
    ViewData["Title"] = "Manage Publishers";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}
@if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="pt-120 pb-120">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="title mb-0">Publisher Management</h2>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="fa fa-plus"></i> Add Publisher
            </button>
        </div>


        <table class="table table-striped table-bordered mt-3">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Publishers != null && Model.Publishers.Any())
                {
                    int count = 1;
                    foreach (var publisher in Model.Publishers)
                    {
                        <tr>
                            <td>@count++</td>
                            <td>@publisher.PublisherName</td>
                            <td>@publisher.Address</td>
                            <td>@publisher.PhoneNumber</td>
                            <td>
                                <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@publisher.Id">
                                    Edit
                                </button>
                                <form asp-page-handler="Delete" method="post" class="d-inline">
                                    <input type="hidden" name="Id" value="@publisher.Id" />
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>

                        <!-- Edit Modal -->
                        <div class="modal fade" id="editModal-@publisher.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Publisher</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-page-handler="Edit" method="post" class="needs-validation" novalidate>
                                        <div class="modal-body">
                                            <input type="hidden" name="Id" value="@publisher.Id" />

                                            <div class="mb-3">
                                                <label class="form-label">Name</label>
                                                <input type="text" name="PublisherName" value="@publisher.PublisherName"
                                                       class="form-control" required />
                                                <div class="invalid-feedback">Name is required.</div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Address</label>
                                                <input type="text" name="Address" value="@publisher.Address"
                                                       class="form-control" />
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">Phone</label>
                                                <input type="text" name="PhoneNumber" value="@publisher.PhoneNumber"
                                                       class="form-control" pattern="^\d{10,15}$" />
                                                <div class="invalid-feedback">Phone must be 10-15 digits.</div>
                                            </div>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="submit" class="btn btn-primary">Save</button>
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No publishers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Publisher</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-page-handler="Create" method="post" class="needs-validation" novalidate>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="PublisherName" class="form-control" required />
                        <div class="invalid-feedback">Name is required.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" name="Address" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="PhoneNumber" class="form-control" pattern="^\d{10,15}$" />
                        <div class="invalid-feedback">Phone must be 10-15 digits.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>


        </div>
    </div>
</div>

<script>
    setTimeout(function () {
        var alertBox = document.querySelector('.alert');
        if (alertBox) {
            var alert = new bootstrap.Alert(alertBox);
            alert.close();
        }
    }, 5000);

    // Bootstrap client-side validation
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();

    // Auto open modal again if validation failed
    document.addEventListener("DOMContentLoaded", function () {
        var statusMessage = '@TempData["StatusMessage"]';
        if (statusMessage.includes("Invalid data") || statusMessage.includes("Invalid publisher data")) {
            const createModal = new bootstrap.Modal(document.getElementById("createModal"));
            createModal.show(); // mở lại modal nếu dữ liệu tạo không hợp lệ
        }
    });
</script>
