@page
@model LibraryWebApp.Pages.BookCopy.IndexModel
@{
    ViewData["Title"] = "Book Copies";
}

<div class="container mt-5">
    <a href="/Book/Index" class="btn btn-secondary mb-3">← Back to Book List</a>
    <h2 class="mb-4">📚 Copies of: <strong>@Model.BookTitle</strong></h2>
    @if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createCopiesModal">
            + Add Book Copies
        </button>
    </div>

    <form method="get" class="row g-3 mb-4">
        <input type="hidden" name="bookId" value="@Model.BookId" />

        <div class="col-md-3">
            <input type="text" name="SearchId" class="form-control" placeholder="Search by Copy ID" value="@Model.SearchId" />
        </div>

        <div class="col-md-3">
            <select name="FilterStatus" class="form-select">
                <option value="">-- Filter by Status --</option>
                @if (Model.FilterStatus == "Available")
                {
                    <option value="Available" selected>Available</option>
                }
                else
                {
                    <option value="Available">Available</option>
                }

                @if (Model.FilterStatus == "Borrowed")
                {
                    <option value="Borrowed" selected>Borrowed</option>
                }
                else
                {
                    <option value="Borrowed">Borrowed</option>
                }

                @if (Model.FilterStatus == "Reserved")
                {
                    <option value="Reserved" selected>Reserved</option>
                }
                else
                {
                    <option value="Reserved">Reserved</option>
                }
            </select>



        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a href="/BookCopy/Index?bookId=@Model.BookId" class="btn btn-secondary">Reset</a>

        </div>
    </form>

    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Copy Code</th>
                <th>Status</th>
                <th>Created At</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BookCopies != null && Model.BookCopies.Any())
            {
                int count = (Model.Page - 1) * Model.PageSize + 1;
                foreach (var copy in Model.BookCopies)
                {
                    <tr>
                        <td>@count++</td>
                        <td>@copy.CopyCode</td>
                        <td>@copy.Status</td>
                        <td>@copy.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@copy.Id">Edit</button>
                            <form asp-page-handler="Delete" method="post" class="d-inline">
                                <input type="hidden" name="Id" value="@copy.Id" />
                                <input type="hidden" name="bookId" value="@Model.BookId" />
                                <button class="btn btn-sm btn-danger" onclick="return confirm('Are you sure to delete this copy?')">Delete</button>
                            </form>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal-@copy.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-page-handler="Edit" method="post">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Book Copy</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" name="Id" value="@copy.Id" />
                                        <input type="hidden" name="bookId" value="@Model.BookId" />
                                        <div class="mb-3">
                                            <label class="form-label">Status</label>
                                            <select name="Status" class="form-select" required>
                                                <option value="">-- Select Status --</option>

                                                @if (copy.Status == "Available")
                                                {
                                                    <option value="Available" selected>Available</option>
                                                }
                                                else
                                                {
                                                    <option value="Available">Available</option>
                                                }

                                                @if (copy.Status == "Borrowed")
                                                {
                                                    <option value="Borrowed" selected>Borrowed</option>
                                                }
                                                else
                                                {
                                                    <option value="Borrowed">Borrowed</option>
                                                }

                                                @if (copy.Status == "Reserved")
                                                {
                                                    <option value="Reserved" selected>Reserved</option>
                                                }
                                                else
                                                {
                                                    <option value="Reserved">Reserved</option>
                                                }
                                            </select>


                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary">Save</button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No copies found.</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @{
                    int startPage = Math.Max(1, Model.Page - 2);

                    int endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                }

                <nav>
                    <ul class="pagination justify-content-center">
                        @* First *@
                        @if (Model.Page > 3)

                        {
                            <li class="page-item">
                                <a class="page-link" href="?bookId=@Model.BookId&searchId=@Model.SearchId&filterStatus=@Model.FilterStatus&pageIndex=1">« First</a>
                            </li>
                        }

                        @* Previous *@
                        @if (Model.Page > 1)

                        {
                            <li class="page-item">
                                <a class="page-link" href="?bookId=@Model.BookId&searchId=@Model.SearchId&filterStatus=@Model.FilterStatus&pageIndex=@(Model.Page - 1)">‹ Prev</a>
                            </li>
                        }

                        @* Page Numbers *@
                        @for (int i = startPage; i <= endPage; i++)

                        {
                            <li class="page-item @(Model.Page == i ? "active" : "")">
                                <a class="page-link" href="?bookId=@Model.BookId&searchId=@Model.SearchId&filterStatus=@Model.FilterStatus&pageIndex=@i">@i</a>
                            </li>
                        }

                        @* Next *@
                        @if (Model.Page < Model.TotalPages)

                        {
                            <li class="page-item">
                                <a class="page-link" href="?bookId=@Model.BookId&searchId=@Model.SearchId&filterStatus=@Model.FilterStatus&pageIndex=@(Model.Page + 1)">Next ›</a>
                            </li>
                        }

                        @* Last *@
                        @if (Model.Page < Model.TotalPages - 2)

                        {
                            <li class="page-item">
                                <a class="page-link" href="?bookId=@Model.BookId&searchId=@Model.SearchId&filterStatus=@Model.FilterStatus&pageIndex=@Model.TotalPages">Last »</a>
                            </li>
                        }
                    </ul>
                </nav>

            </ul>
        </nav>
    }

    <!-- Create Copies Modal -->
    <div class="modal fade" id="createCopiesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-page-handler="CreateCopies" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Book Copies</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="bookId" value="@Model.BookId" />

                        <div class="mb-3">
                            <label class="form-label">Number of Copies</label>
                            <input type="number" name="NumberOfCopies" class="form-control" min="1" value="1" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Initial Status</label>
                            <select name="Status" class="form-select" required>
                                <option value="">-- Select Status --</option>
                                <option value="Available" selected>Available</option>
                                <option value="Borrowed">Borrowed</option>
                                <option value="Reserved">Reserved</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Tự động ẩn alert sau 5s
    setTimeout(function () {
        var alertBox = document.querySelector('.alert');
        if (alertBox) {
            var alert = new bootstrap.Alert(alertBox);
            alert.close();
        }
    }, 5000);

    // Clear form khi đóng modal tạo mới
    const createModal = document.getElementById('createCopiesModal');
    createModal?.addEventListener('hidden.bs.modal', function () {
        const form = createModal.querySelector('form');
        if (form) {
            form.reset();
        }
    });
</script>
