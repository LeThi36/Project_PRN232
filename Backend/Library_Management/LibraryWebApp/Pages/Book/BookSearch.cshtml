@page
@model LibraryWebApp.Pages.Book.BookSearchModel
@{
    ViewData["Title"] = "Search Books";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <!-- 🔍 Search Filters -->
    <form method="get" class="row g-3 mb-4 bg-light p-3 rounded shadow-sm">
        <div class="col-md-3">
            <input name="SearchTerm" class="form-control" placeholder="🔎 Search by title..." value="@Model.SearchTerm" />
        </div>
        <div class="col-md-3">
            <select name="AuthorId" class="form-select">
                <option value="">-- Select Author --</option>
                @foreach (var author in Model.Authors)
                {
                    <option value="@author.Value" selected="@(author.Value == Model.AuthorId ? "selected" : null)">@author.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="CategoryId" class="form-select">
                <option value="">-- Select Category --</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Value" selected="@(category.Value == Model.CategoryId ? "selected" : null)">@category.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="PublisherId" class="form-select">
                <option value="">-- Select Publisher --</option>
                @foreach (var publisher in Model.Publishers)
                {
                    <option value="@publisher.Value" selected="@(publisher.Value == Model.PublisherId ? "selected" : null)">@publisher.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/Book/BookSearch" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <!-- 📋 Book Table -->
    <div class="table-responsive shadow rounded">
        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>📖 Title</th>
                    <th>👤 Author</th>
                    <th>🏷️ Category</th>
                    <th>🏢 Publisher</th>
                    <th class="text-center">⚙️ Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.AuthorName</td>
                        <td>@book.CategoryName</td>
                        <td>@book.PublisherName</td>
                        <td class="text-center">
                            <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                            <button class="btn btn-sm btn-danger" onclick="confirmDelete('@book.Id')">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 📄 Pagination Controls -->
    <div class="d-flex justify-content-center align-items-center mt-4 gap-3">
        <button class="btn btn-outline-primary" onclick="goToPage(@(Model.CurrentPage - 1))" @(Model.CurrentPage <= 1 ? "disabled" : null)>←</button>

        <input id="pageInput" type="number" class="form-control text-center" value="@Model.CurrentPage" style="width: 80px;" onkeydown="if(event.key === 'Enter') jumpToPage(event)" />

        <button class="btn btn-outline-primary" onclick="goToPage(@(Model.CurrentPage + 1))" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)>→</button>
    </div>
</div>
<script>
    const apiBaseUrl = "@Model.ApiBaseUrl";

    function goToPage(page) {
        const url = new URL(window.location.href);
        url.searchParams.set("PageNumber", page);
        window.location.href = url.toString();
    }

    function jumpToPage(event) {
        event.preventDefault();
        const page = parseInt(document.getElementById("pageInput").value);
        if (!isNaN(page) && page > 0) {
            goToPage(page);
        }
    }
</script>

